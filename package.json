{
  "name": "cursor-plan-usage",
  "displayName": "Cursor Plan Usage",
  "description": "Dockable sidebar showing Cursor Models and Other Models plan usage percentages.",
  "version": "0.1.0",
  "publisher": "CodyKoInABox",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodyKoInABox/cursor-plan-usage.git"
  },
  "bugs": {
    "url": "https://github.com/CodyKoInABox/cursor-plan-usage/issues"
  },
  "homepage": "https://github.com/CodyKoInABox/cursor-plan-usage#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "usage",
    "plan",
    "billing"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorPlanUsage",
          "title": "Plan Usage",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "cursorPlanUsage": [
        {
          "type": "webview",
          "id": "cursorPlanUsage.panel",
          "name": "Plan Usage"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorPlanUsage.focus",
        "title": "Plan Usage: Focus",
        "category": "Plan Usage"
      },
      {
        "command": "cursorPlanUsage.refresh",
        "title": "Plan Usage: Refresh",
        "icon": "$(refresh)",
        "category": "Plan Usage"
      },
      {
        "command": "cursorPlanUsage.setSessionToken",
        "title": "Plan Usage: Set Session Token",
        "category": "Plan Usage"
      },
      {
        "command": "cursorPlanUsage.clearSessionToken",
        "title": "Plan Usage: Clear Session Token",
        "category": "Plan Usage"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cursorPlanUsage.refresh",
          "when": "view == cursorPlanUsage.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Cursor Plan Usage",
      "properties": {
        "cursorPlanUsage.pollIntervalSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Idle poll interval in seconds while Cursor is focused. 0 = adaptive (30s for 2 min after AI activity, then 3 min). Set higher to override the idle interval. Polling pauses while unfocused; AI activity and focus still refresh."
        },
        "cursorPlanUsage.refreshOnAiActivity": {
          "type": "boolean",
          "default": true,
          "description": "Near-real-time refresh when Cursor's local AI tracking DB updates (Agent / AI edits)."
        },
        "cursorPlanUsage.statusBarMode": {
          "type": "string",
          "default": "absolute",
          "enum": [
            "absolute",
            "usageSoFar"
          ],
          "enumDescriptions": [
            "Total usage in the current billing cycle (CM 45% · OM 20%).",
            "Usage since you last pressed Reset in the sidebar (CM +4% · OM +2%)."
          ],
          "description": "What the status bar chip shows."
        },
        "cursorPlanUsage.apiBaseUrl": {
          "type": "string",
          "default": "https://api2.cursor.sh",
          "description": "Cursor API base URL for dashboard RPC calls."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
